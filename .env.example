# Supabase-Projekt (Project Settings -> API in Supabase).
# NEXT_PUBLIC_* Variablen landen im Browser-Bundle -- hier ist das laut Design
# so vorgesehen: der Anon Key ist bewusst öffentlich, Zugriffsschutz läuft über
# Row-Level-Security-Policies (siehe supabase/migrations), nicht über Geheimhaltung.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absichtlich NICHT hier: der Service-Role-Key. Der ist ein echtes Secret
# (umgeht RLS komplett) und gehört laut CLAUDE.md ("Secrets nur serverseitig")
# ausschließlich in die Secret-Verwaltung der Deployment-Plattform, nie in
# diese Datei und nie in den Browser.
